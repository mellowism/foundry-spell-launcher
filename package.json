{
  "name": "foundry-spell-launcher",
  "version": "0.1.3",
  "description": "Foundry VTT V13 module — DM-side spell animation launcher (Sequencer + JB2A). No per-item config, no game mechanics, just visuals.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rimraf dist && rollup -c && node scripts/sync-manifest.mjs",
    "watch": "rollup -c -w",
    "clean": "rimraf dist",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "rollup": "^4.24.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "rimraf": "^6.0.1"
  },
  "license": "MIT"
}
